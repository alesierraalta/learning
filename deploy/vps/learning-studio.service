[Unit]
Description=Learning studio (tailnet only)
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/learning
Environment=PATH=%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/learning-studio.env
ExecStart=/usr/bin/node studio/server.ts
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
