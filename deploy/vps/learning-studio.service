[Unit]
Description=Learning studio (ZeroTier only)
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/learning
Environment=PATH=%h/.local/node/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/learning-studio.env
ExecStart=%h/.local/node/bin/node studio/server.ts
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
