STUDIO_BRIDGE_PUBLIC_ORIGIN=https://10.154.59.151:8446,https://learnings.infra.local:8446
STUDIO_BRIDGE_PORT=4748
PATH=/home/ale/.local/node/bin:/home/ale/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
