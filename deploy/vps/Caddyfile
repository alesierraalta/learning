# TLS front for the learning studio on the ZeroTier address only.
# The certificate is the Infra Root CA service certificate (SAN IP:10.154.59.151).
# Caddy forwards the incoming Host, which the studio and bridge allow-list.
{
	admin off
	auto_https off
}

:8445 {
	bind 10.154.59.151
	tls /certs/infra.pem /certs/infra-key.pem
	reverse_proxy 127.0.0.1:4747
}

:8446 {
	bind 10.154.59.151
	tls /certs/infra.pem /certs/infra-key.pem
	reverse_proxy 127.0.0.1:4748
}
